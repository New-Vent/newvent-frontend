{
  "name": "newvent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cross-env APP=admin vite",
    "dev:admin:mock": "cross-env APP=admin VITE_API_AUTH=off vite",
    "build": "npm run build:user && npm run build:admin",
    "build:user": "vite build",
    "build:admin": "cross-env APP=admin vite build",
    "preview": "vite preview",
    "preview:admin": "cross-env APP=admin vite preview",
    "css": "node scripts/build-event-css.mjs",
    "css:check": "node scripts/build-event-css.mjs --check"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "vite": "^8.3.1"
  }
}
